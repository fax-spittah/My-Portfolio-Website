---
import { Icon } from "astro-icon/components";
import HamburgerMenu from "./HamburgerMenu.astro";
import data from "../data/general.json";

const fullName = data.fullName;
const shortName = data.shortName;
---

<div x-data="{ open: false }" class="header-container fixed inset-x-0 top-0 z-50 px-3 pt-3 sm:px-6 sm:pt-4 print-hide">
  <div class="mx-auto flex max-w-6xl items-center justify-between rounded-full border border-slate-200/80 bg-white/80 px-4 py-3 shadow-[0_20px_60px_-24px_rgba(15,23,42,0.35)] backdrop-blur-xl dark:border-slate-700/80 dark:bg-slate-900/80 sm:px-6">
    <div class="flex items-center gap-4">
      <p class="text-lg font-semibold tracking-tight text-slate-900 dark:text-white sm:text-xl">
        <a href="/home" class="hidden md:block">{fullName}</a>
        <a href="/home" class="md:hidden">{shortName}</a>
      </p>
    </div>

    <div class="flex items-center gap-2 md:hidden">
      <span class="ml-auto" @click="open = !open">
        <Icon
          x-show="!open"
          name="burgermenu"
          class="h-7 w-7 text-slate-600 dark:text-slate-300"
        />
        <Icon
          x-show="open"
          name="closeicon"
          class="h-7 w-7 text-slate-600 dark:text-slate-300"
        />
      </span>
    </div>

    <div class="hidden items-center gap-2 md:flex">
      <a
        href="/home"
        class="rounded-full px-4 py-2 text-sm font-medium text-slate-700 transition-colors duration-300 hover:bg-slate-100 hover:text-blue-600 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-blue-400"
        >Home</a
      >
      <a
        href="/about"
        class="rounded-full px-4 py-2 text-sm font-medium text-slate-700 transition-colors duration-300 hover:bg-slate-100 hover:text-blue-600 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-blue-400"
        >About</a
      >
      <a
        href="/cv"
        class="rounded-full px-4 py-2 text-sm font-medium text-slate-700 transition-colors duration-300 hover:bg-slate-100 hover:text-blue-600 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-blue-400"
        >CV</a
      >
      <button
        id="theme-selector"
        class="inline-flex items-center rounded-full bg-slate-900 px-3 py-2 text-white shadow-sm transition-all duration-300 hover:scale-105 hover:bg-slate-700 dark:bg-slate-100 dark:text-slate-900 dark:hover:bg-slate-300"
        aria-label="Toggle theme"
      >
        <Icon name="sun" class="h-5 w-5 dark:hidden" />
        <Icon name="moon" class="hidden h-5 w-5 dark:inline" />
      </button>
    </div>
  </div>

  <div x-show="open" x-cloak x-transition class="mt-3 md:hidden">
    <HamburgerMenu />
  </div>

  <style>
    @media print {
      .header-container {
        display: none;
      }
    }
  </style>

  <script>
    document.getElementById("theme-selector")?.addEventListener("click", () => {
      if (localStorage.theme === "dark") {
        localStorage.theme = "light";
        document.documentElement.classList.remove("dark");
      } else {
        localStorage.theme = "dark";
        document.documentElement.classList.add("dark");
      }
    });
  </script>
</div>
