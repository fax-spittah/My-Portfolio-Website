---
interface Props {
  institutionImg: string;
  institutionName: string;
  program: string;
  degree?: string;
  startDate: string;
  endDate: string;
  description: string;
}

const {
  institutionImg,
  institutionName,
  program,
  degree,
  startDate,
  endDate,
  description,
}: Props = Astro.props;
---

<div class="mx-auto mt-6 rounded-[1.5rem] border border-slate-200/80 bg-white/90 p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-md dark:border-slate-700/80 dark:bg-slate-800/80">
  <div class="mb-4 flex items-start gap-4">
    <div class="flex h-14 w-14 flex-shrink-0 items-center justify-center rounded-2xl bg-blue-50 dark:bg-blue-500/10">
      <img src={institutionImg} alt="Institution Icon" class="h-8 w-8 object-contain" />
    </div>
    <div>
      <h3 class="text-lg font-semibold text-slate-900 dark:text-white">
        {institutionName}
      </h3>
      <p class="mt-1 text-sm font-semibold text-blue-600 dark:text-blue-400">
        {program}
        {degree && <> · {degree}</>}
      </p>
      <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
        {startDate} - {endDate}
      </p>
    </div>
  </div>

  <p class="mt-4 text-sm leading-7 text-slate-600 dark:text-slate-300">
    {description}
  </p>
</div>
