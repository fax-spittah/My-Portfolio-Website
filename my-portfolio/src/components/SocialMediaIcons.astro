---
import { Icon } from "astro-icon/components";

interface Props {
  iconName: string;
  linkUrl?: string;
  title?: string;
}

const { iconName, linkUrl, title }: Props = Astro.props;
---

<a
  href={linkUrl}
  target="_blank"
  rel="noreferrer"
  title={title}
  class="inline-flex h-12 w-12 items-center justify-center rounded-full border border-slate-200 bg-white text-slate-600 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:border-blue-400 dark:hover:text-blue-400"
>
  <Icon name={iconName} class="h-5 w-5" />
</a>
