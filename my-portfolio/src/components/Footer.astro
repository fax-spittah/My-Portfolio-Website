---
import data from "../data/general.json";

const email = data.contactInformation.email;
const linkedInURL = data.contactInformation.linkedInUrl;
const discord = data.contactInformation.discord;
---

<footer
  class="border-t border-slate-200 bg-slate-50/80 text-slate-900 backdrop-blur dark:border-slate-800 dark:bg-slate-950/80 dark:text-slate-100"
>
  <div
    class="mx-auto flex max-w-6xl flex-col gap-8 px-4 py-12 sm:px-6 lg:flex-row lg:justify-between lg:px-8"
  >
    <div class="max-w-md">
      <h2 class="mb-4 text-lg font-semibold text-blue-600 dark:text-blue-400">
        Connect with me
      </h2>
      <div class="space-y-2 text-sm text-slate-600 dark:text-slate-300">
        <p>
          <a
            href={linkedInURL}
            target="_blank"
            rel="noreferrer"
            class="transition-colors hover:text-blue-600 dark:hover:text-blue-400"
            >LinkedIn</a
          >
        </p>
        <p>
          <a
            href={`mailto:${email}`}
            class="transition-colors hover:text-blue-600 dark:hover:text-blue-400"
            >Email</a
          >
        </p>
        <p>
          <a
            href={discord}
            target="_blank"
            rel="noreferrer"
            class="transition-colors hover:text-blue-600 dark:hover:text-blue-400"
            >Discord</a
          >
        </p>
      </div>
    </div>

    <div class="max-w-md">
      <h2 class="mb-4 text-lg font-semibold text-blue-600 dark:text-blue-400">
        Navigation
      </h2>
      <nav
        class="flex flex-col gap-2 text-sm text-slate-600 dark:text-slate-300"
      >
        <a
          href="/home"
          class="transition-colors hover:text-blue-600 dark:hover:text-blue-400"
          >Home</a
        >
        <a
          href="/about"
          class="transition-colors hover:text-blue-600 dark:hover:text-blue-400"
          >About</a
        >
        <a
          href="/cv"
          class="transition-colors hover:text-blue-600 dark:hover:text-blue-400"
          >CV</a
        >
      </nav>
    </div>
  </div>

  <div class="border-t border-slate-200 dark:border-slate-800">
    <div
      class="mx-auto flex max-w-6xl flex-col gap-3 px-4 py-6 text-sm text-slate-600 sm:px-6 sm:flex-row sm:items-center sm:justify-between lg:px-8 dark:text-slate-400"
    >
      <p>
        &copy; {new Date().getFullYear()} Edison Kiseh. All rights reserved.
      </p>
      <a
        href="https://github.com/fax-spittah/My-Portfolio-Website"
        target="_blank"
        rel="noreferrer"
        class="font-medium text-blue-600 transition-colors hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300"
      >
        Website Source Code
      </a>
    </div>
  </div>
</footer>
