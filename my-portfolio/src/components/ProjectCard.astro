---
interface Props {
  projectTitle: string;
  projectDescription: string;
  projectLink?: string;
  projectImage: string;
}

const { projectTitle, projectDescription, projectLink, projectImage }: Props =
  Astro.props;
---

<div
  class="group flex h-full flex-col rounded-[1.5rem] border border-slate-200/80 bg-white/90 p-6 shadow-[0_20px_50px_-24px_rgba(15,23,42,0.35)] transition-all duration-300 hover:-translate-y-1 hover:border-blue-400 hover:shadow-[0_24px_60px_-20px_rgba(59,130,246,0.35)] dark:border-slate-700/80 dark:bg-slate-800/80"
>
  <div
    class="mb-4 inline-flex h-11 w-11 items-center justify-center rounded-2xl bg-blue-50 text-blue-600 dark:bg-blue-500/10 dark:text-blue-400"
  >
    <img
      src={projectImage}
      alt={projectTitle}
      class="h-6 w-6 object-contain dark:invert"
    />
  </div>
  <a href={projectLink} target="_blank" rel="noreferrer">
    <h5
      class="mb-2 text-xl font-semibold tracking-tight text-slate-900 transition-colors group-hover:text-blue-600 dark:text-white dark:group-hover:text-blue-400"
    >
      {projectTitle}
    </h5>
  </a>
  <p class="mb-5 flex-1 text-sm leading-7 text-slate-600 dark:text-slate-300">
    {projectDescription}
  </p>

  {
    projectLink && (
      <a
        href={projectLink}
        target="_blank"
        rel="noreferrer"
        class="inline-flex items-center font-semibold text-blue-600 transition-colors hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300"
      >
        Learn More
        <svg
          class="ms-2 h-3 w-3"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 18 18"
        >
          <path
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M15 11v4.833A1.166 1.166 0 0 1 13.833 17H2.167A1.167 1.167 0 0 1 1 15.833V4.167A1.166 1.166 0 0 1 2.167 3h4.618m4.447-2H17v5.768M9.111 8.889l7.778-7.778"
          />
        </svg>
      </a>
    )
  }
</div>
