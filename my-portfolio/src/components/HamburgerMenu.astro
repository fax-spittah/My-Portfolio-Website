---
import { Icon } from "astro-icon/components";
---

<div class="rounded-[1.5rem] border border-slate-200/80 bg-white/95 p-5 shadow-2xl backdrop-blur-xl dark:border-slate-700/80 dark:bg-slate-900/95">
  <ul class="flex flex-col gap-3 text-slate-700 dark:text-slate-200">
    <a href="/home" class="rounded-2xl px-4 py-3 text-base font-medium transition-colors hover:bg-slate-100 hover:text-blue-600 dark:hover:bg-slate-800 dark:hover:text-blue-400">
      <li>Home</li>
    </a>
    <a href="/about" class="rounded-2xl px-4 py-3 text-base font-medium transition-colors hover:bg-slate-100 hover:text-blue-600 dark:hover:bg-slate-800 dark:hover:text-blue-400">
      <li>About</li>
    </a>
    <a href="/cv" class="rounded-2xl px-4 py-3 text-base font-medium transition-colors hover:bg-slate-100 hover:text-blue-600 dark:hover:bg-slate-800 dark:hover:text-blue-400">
      <li>CV</li>
    </a>
    <li class="pt-2">
      <button
        id="theme-selector-mobile"
        class="inline-flex w-full items-center justify-center rounded-2xl bg-slate-900 px-4 py-3 font-semibold text-white transition-colors hover:bg-slate-700 dark:bg-slate-100 dark:text-slate-900 dark:hover:bg-slate-300"
      >
        <Icon name="sun" class="h-5 w-5 dark:hidden" />
        <Icon name="moon" class="hidden h-5 w-5 dark:inline" />
      </button>
    </li>
  </ul>
</div>

<script>
  document
    .getElementById("theme-selector-mobile")
    ?.addEventListener("click", () => {
      if (localStorage.theme === "dark") {
        localStorage.theme = "light";
        document.documentElement.classList.remove("dark");
      } else {
        localStorage.theme = "dark";
        document.documentElement.classList.add("dark");
      }
    });
</script>
