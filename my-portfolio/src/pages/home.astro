---
import Header from "../components/Header.astro";
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import ProjectCard from "../components/ProjectCard.astro";

import profileImage from "../assets/my-pic.jpg";
import SocialMediaIcons from "../components/SocialMediaIcons.astro";
import data from "../data/general.json";

import cvData from "../data/cv.json";

const email = data.contactInformation.email;
const linkedInURL = data.contactInformation.linkedInUrl;
const discord = data.contactInformation.discord;
const github = data.contactInformation.github;
const instagram = data.contactInformation.instagram;
const projects = cvData.cvMainSide.projects;
---

<Layout>
  <Header />

  <main class="overflow-x-hidden">
    <section
      class="flex min-h-screen items-center justify-center px-4 pb-16 pt-24 sm:px-6 lg:px-8 lg:pt-32"
    >
      <div
        class="w-full max-w-6xl rounded-[2rem] border border-slate-200/70 bg-white/80 p-6 shadow-[0_20px_80px_-24px_rgba(15,23,42,0.35)] backdrop-blur-xl dark:border-slate-800 dark:bg-slate-900/70 sm:p-8 lg:p-12"
      >
        <div class="grid items-center gap-10 lg:grid-cols-[1.05fr_0.95fr]">
          <div class="text-center lg:text-left">
            <span
              class="inline-flex rounded-full border border-blue-200 bg-blue-50 px-4 py-2 text-sm font-medium text-blue-700 dark:border-blue-900/60 dark:bg-blue-500/10 dark:text-blue-300"
            >
              Available for meaningful product work
            </span>
            <h1
              class="mt-6 text-4xl font-semibold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl dark:text-white"
            >
              Turning ideas into <span
                class="bg-gradient-to-r from-blue-600 to-cyan-500 bg-clip-text text-transparent"
                >modern digital experiences</span
              >.
            </h1>
            <p
              class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-slate-600 sm:text-xl dark:text-slate-300 lg:mx-0"
            >
              I'm Edison Kiseh, a full-stack developer focused on polished
              interfaces, thoughtful product design, and reliable engineering
              that feels effortless.
            </p>
            <div
              class="mt-8 flex flex-col justify-center gap-3 sm:flex-row lg:justify-start"
            >
              <a
                href="/cv"
                class="rounded-full bg-slate-900 px-6 py-3 text-center font-semibold text-white transition-all duration-300 hover:-translate-y-0.5 hover:bg-slate-700 dark:bg-slate-100 dark:text-slate-900 dark:hover:bg-slate-300"
              >
                View CV
              </a>
              <a
                href="#projects"
                class="rounded-full border border-slate-300 px-6 py-3 text-center font-semibold text-slate-700 transition-all duration-300 hover:-translate-y-0.5 hover:border-blue-500 hover:text-blue-600 dark:border-slate-700 dark:text-slate-200 dark:hover:border-blue-400 dark:hover:text-blue-400"
              >
                Explore Projects
              </a>
            </div>
            <div
              class="mt-8 flex flex-wrap items-center justify-center gap-3 lg:justify-start"
            >
              <SocialMediaIcons
                iconName="email"
                linkUrl={email}
                title="Email"
              />
              <SocialMediaIcons
                iconName="discord"
                linkUrl={discord}
                title="Discord"
              />
              <SocialMediaIcons
                iconName="github"
                linkUrl={github}
                title="GitHub"
              />
              <SocialMediaIcons
                iconName="linkedIn"
                linkUrl={linkedInURL}
                title="LinkedIn"
              />
              <SocialMediaIcons
                iconName="instagram"
                linkUrl={instagram}
                title="Instagram"
              />
            </div>
          </div>

          <div class="flex justify-center lg:justify-end">
            <div class="relative w-full max-w-[14rem] sm:max-w-sm">
              <img
                src={profileImage.src}
                alt="Profile Picture"
                class="aspect-square w-full rounded-[2rem] border border-slate-200 object-cover shadow-[0_20px_60px_-24px_rgba(15,23,42,0.4)] dark:border-slate-800"
              />
              <div
                class="absolute -bottom-4 left-2 rounded-2xl border border-slate-200 bg-white/90 px-3 py-2 text-xs font-medium text-slate-700 shadow-lg backdrop-blur sm:-bottom-6 sm:-left-4 sm:px-4 sm:py-3 sm:text-sm dark:border-slate-700 dark:bg-slate-900/90 dark:text-slate-200"
              >
                Full Stack Developer
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="about" class="px-4 py-20 sm:px-6 lg:px-8">
      <div
        class="mx-auto max-w-5xl rounded-[2rem] border border-slate-200/70 bg-white/80 p-8 shadow-[0_20px_60px_-24px_rgba(15,23,42,0.2)] backdrop-blur-xl dark:border-slate-800 dark:bg-slate-900/70 sm:p-10 lg:p-12"
      >
        <p
          class="text-center text-lg font-semibold text-blue-600 dark:text-blue-400"
        >
          Hey there! 👋
        </p>
        <h2
          class="mt-4 text-center text-3xl font-semibold text-slate-900 sm:text-4xl dark:text-white"
        >
          About me
        </h2>
        <p
          class="mx-auto mt-6 max-w-3xl text-center text-lg leading-8 text-slate-600 dark:text-slate-300"
        >
          My name is <span
            class="font-semibold text-slate-900 dark:text-slate-100"
            >Edison Kiseh</span
          >, and I’m a Cameroonian living in Belgium. I’m passionate about
          coding, sports, and music, and I enjoy turning ambitious ideas into
          elegant digital experiences.
        </p>
        <div class="mt-8 flex justify-center">
          <a
            href="/about"
            class="rounded-full bg-blue-600 px-6 py-3 font-semibold text-white transition-all duration-300 hover:-translate-y-0.5 hover:bg-blue-700"
          >
            Read More
          </a>
        </div>
      </div>
    </section>

    <section id="projects" class="px-4 pb-24 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-6xl">
        <div class="mb-10 text-center">
          <p
            class="text-sm font-semibold uppercase tracking-[0.3em] text-blue-600 dark:text-blue-400"
          >
            Featured work
          </p>
          <h2
            class="mt-3 text-3xl font-semibold text-slate-900 sm:text-4xl dark:text-white"
          >
            Projects
          </h2>
        </div>
        <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
          {
            projects.map((project) => (
              <ProjectCard
                projectTitle={project.projectName}
                projectDescription={project.description}
                projectLink={project.githubLink}
                projectImage={project.image}
              />
            ))
          }
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
