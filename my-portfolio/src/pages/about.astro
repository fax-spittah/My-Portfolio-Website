---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Layout from "../layouts/Layout.astro";
import technologies from "../data/technologies.json";
import TechnologyCard from "../components/about/TechnologyCard.astro";
import EducationAndExperienceCard from "../components/about/EducationAndExperienceCard.astro";
import thomasMoreImg from "../icons/thomasMoreLogo.svg";
import avandeIcon from "../icons/avanadeLogo.svg";
import aboutData from "../data/about.json";

const frontendTechnologies = technologies.frontend;
const backendTechnologies = technologies.backend;
const devopsTechnologies = technologies.devops;
const otherTechnologies = technologies.others;
const education = aboutData.about.education;
const experience = aboutData.about.experience;
const aboutMe = aboutData.about.aboutMe;
---

<Layout>
  <Header />

  <main class="overflow-x-hidden px-4 pb-20 pt-24 sm:px-6 lg:px-8 lg:pt-32">
    <section
      class="mx-auto max-w-6xl rounded-[2rem] border border-slate-200/70 bg-white/80 p-6 shadow-[0_20px_80px_-24px_rgba(15,23,42,0.25)] backdrop-blur-xl dark:border-slate-800 dark:bg-slate-900/70 sm:p-8 lg:p-12"
    >
      <div class="mx-auto max-w-3xl text-center">
        <p
          class="text-sm font-semibold uppercase tracking-[0.3em] text-blue-600 dark:text-blue-400"
        >
          About me
        </p>
        <h2
          class="mt-3 text-3xl font-semibold text-slate-900 sm:text-4xl dark:text-white"
        >
          Full Stack Developer & Tech Enthusiast
        </h2>
        <div
          class="mt-6 space-y-4 text-lg leading-8 text-slate-600 dark:text-slate-300"
        >
          {aboutMe.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
    </section>

    <section
      class="mx-auto mt-10 max-w-6xl rounded-[2rem] border border-slate-200/70 bg-white/80 p-6 shadow-[0_20px_60px_-24px_rgba(15,23,42,0.2)] backdrop-blur-xl dark:border-slate-800 dark:bg-slate-900/70 sm:p-8 lg:p-10"
    >
      <div class="mb-8 text-center">
        <h3
          class="text-2xl font-semibold text-slate-900 sm:text-3xl dark:text-white"
        >
          Used Technologies
        </h3>
      </div>
      <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
        <TechnologyCard title="Frontend" technologies={frontendTechnologies} />
        <TechnologyCard title="Backend" technologies={backendTechnologies} />
        <TechnologyCard title="DevOps" technologies={devopsTechnologies} />
        <TechnologyCard title="Other" technologies={otherTechnologies} />
      </div>
    </section>

    <section class="mx-auto mt-10 max-w-6xl grid gap-6 lg:grid-cols-2">
      <div
        class="rounded-[2rem] border border-slate-200/70 bg-white/80 p-6 shadow-[0_20px_60px_-24px_rgba(15,23,42,0.2)] backdrop-blur-xl dark:border-slate-800 dark:bg-slate-900/70 sm:p-8"
      >
        <h3
          class="text-center text-2xl font-semibold text-slate-900 dark:text-white"
        >
          Education
        </h3>
        <EducationAndExperienceCard
          institutionImg={thomasMoreImg.src}
          institutionName={education.institutionName}
          program={education.program}
          degree={education.degree}
          startDate={education.startDate}
          endDate={education.endDate}
          description={education.description}
        />
      </div>

      <div
        class="rounded-[2rem] border border-slate-200/70 bg-white/80 p-6 shadow-[0_20px_60px_-24px_rgba(15,23,42,0.2)] backdrop-blur-xl dark:border-slate-800 dark:bg-slate-900/70 sm:p-8"
      >
        <h3
          class="text-center text-2xl font-semibold text-slate-900 dark:text-white"
        >
          Experience
        </h3>
        <EducationAndExperienceCard
          institutionImg={avandeIcon.src}
          institutionName={experience[0].institutionName}
          program={experience[0].program}
          startDate={experience[0].startDate}
          endDate={experience[0].endDate}
          description={experience[0].description}
        />
      </div>
    </section>
  </main>

  <Footer />
</Layout>
